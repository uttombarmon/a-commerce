{
  "name": "acommerce-scaffold",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r run build --if-present",
    "lint": "pnpm -r run lint --if-present",
    "db:generate": "pnpm --filter database run generate",
    "db:push": "pnpm --filter database run push"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}