FROM node:20-alpine AS builder
WORKDIR /app

# Copy package manifests
COPY package*.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/

# Install all dependencies
RUN npm ci

# Copy source code
COPY packages/database ./packages/database
COPY apps/api ./apps/api

# Build API and dependencies
RUN npm run build --workspace=database && npm run build --workspace=api


# --- Target for DB Setup (Preserves devDependencies like drizzle-kit) ---
FROM node:20-alpine AS db-setup
WORKDIR /app

COPY package*.json ./
COPY packages/database ./packages/database

# Copy node_modules from builder so CLI tools are available
COPY --from=builder /app/node_modules ./node_modules

CMD ["npm", "run", "db:push"]


# --- Target for Production API ---
FROM node:20-alpine AS runner
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/database/package.json ./packages/database/

# Install production dependencies (workspace symlinks created properly)
RUN npm ci --omit=dev

# Copy compiled API build output from builder stage
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy database package from builder (includes compiled dist and src for drizzle)
COPY --from=builder /app/packages/database ./packages/database

EXPOSE 4000
CMD ["npm", "start", "--workspace=api"]